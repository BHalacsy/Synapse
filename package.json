{
  "name": "synapse-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "turbo check-types",
    "db:generate": "pnpm --filter synapse-backend db:generate",
    "db:migrate": "pnpm --filter synapse-backend db:migrate",
    "db:studio": "pnpm --filter synapse-backend db:studio",
    "lint": "turbo lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist apps/*/.turbo packages/*/.turbo .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1"
  }
}
